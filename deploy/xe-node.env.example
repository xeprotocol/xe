# /etc/xe/xe-node.env — XE node systemd environment configuration

# Data directory for chain state, ledger, and badger store
XE_DATA_DIR=/var/lib/xe/data

# P2P listen port
XE_P2P_PORT=9000

# Bootstrap peer multiaddrs (comma-separated).
# Defaults to the live testnet-0005 bootstrap nodes (London, Frankfurt, New York).
# Confirm against live nodes with: curl -s https://ldn.core.test.network/node | jq -r .id
XE_BOOTSTRAP=/ip4/45.77.226.208/tcp/9000/p2p/12D3KooWJg4PQYGSfNCupBWZdEWbKj7pgdp5MmmUXbPdBcp6YDtT,/ip4/192.248.176.245/tcp/9000/p2p/12D3KooWEbQ5zDvSz6kKE5ppzwBXKRFsnZbHNjRx94QZFaPeGA4e,/ip4/144.202.4.117/tcp/9000/p2p/12D3KooWEqv1BRZkSntgcgbrJh7bobFRSkBdRupubvNZLEx8hZLA

# Directory holding ledger-genesis.json and statechain-genesis.json.
# Mandatory for joining a network. Copy from genesis/<network_id>/ (e.g. genesis/testnet-0005/).
XE_GENESIS_DIR=/etc/xe/genesis

# HTTP API server bind address and port
XE_API_BIND=127.0.0.1
XE_API_PORT=8080

# Metrics listener for /metrics, /health, and /ready (loopback default; empty disables it)
XE_METRICS_ADDR=127.0.0.1:9095

# Logging level: debug|info|warn|error
XE_LOG_LEVEL=info

# Extra command-line flags passed to 'xe node' (e.g. --disable-mdns, --max-inbound-conns 128)
XE_EXTRA_ARGS=
