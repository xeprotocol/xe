# XE node configuration (#839). Install to /etc/xe/xe-node.env, mode 0640,
# owned by root:xe. Every value here is public — this file holds no secrets.
# The node's identity key is generated on first start inside XE_DATA_DIR.

# Data directory: ledger, statechain, libp2p identity. Back this up, or at
# least know that losing it means a cold resync and a new peer id.
XE_DATA_DIR=/var/lib/xe/data

# libp2p listen port. Must be reachable from the internet for this node to
# serve sync to others; a node that can only dial out still follows the chain
# but cannot be discovered or dialled.
XE_P2P_PORT=9000

# Bootstrap peers, comma-separated multiaddrs. Published in
# docs/run-a-node.md — replace with the real values for the network you are
# joining. There is no ambient peer discovery today, so this list IS this
# node's view of the network.
XE_BOOTSTRAP=REPLACE_ME

# Directory holding ledger-genesis.json and statechain-genesis.json for the
# network being joined (#733). Leave this pointing at the published genesis
# for your network. Without it the node runs whatever genesis the binary was
# compiled with, which for a clean-master build is a placeholder that no
# real network uses.
XE_GENESIS_DIR=/etc/xe/genesis

# HTTP API. Keep bound to localhost unless you are deliberately publishing it;
# only POST /lease/request is authenticated.
XE_API_BIND=127.0.0.1
XE_API_PORT=8080

# Anything else, appended verbatim. Examples:
#   --ui --ui-bind 127.0.0.1 --ui-port 8000
#   --provide --vcpus 8 --memory 16384 --disk 200
#   --max-conns-per-ip 16
XE_EXTRA_ARGS=
