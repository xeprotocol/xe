# Environment for xe-node.service. Install at /etc/xe/xe-node.env.

XE_P2P_PORT=9000
XE_API_PORT=8080
XE_API_BIND=127.0.0.1
XE_DATA_DIR=/var/lib/xe
XE_DIAL=

# Operator listener: /metrics, /health, /ready. LOOPBACK BY DEFAULT.
# /metrics is an unauthenticated firehose of network-wide state — widen this
# only to a private interface, never to a public one. Empty disables it.
XE_METRICS_ADDR=127.0.0.1:9095

# debug | info | warn | error. Turning this down is the fastest way to reduce
# log volume during disk pressure, and it applies to every log line in the
# process, including the ones not yet converted to the levelled logger.
XE_LOG_LEVEL=info

# Log file rotation, used only when the node is started with -log-file.
# Total on-disk bound is XE_LOG_MAX_SIZE_MB * (XE_LOG_MAX_FILES + 1).
XE_LOG_MAX_SIZE_MB=64
XE_LOG_MAX_FILES=5

# Operator-only endpoints (POST /lease/request) stay disabled without this.
# XE_API_ADMIN_TOKEN=
